<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.Pages.ChartTestPage"
             xmlns:local="clr-namespace:TimeTracker.PageModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:DataType="local:ChartTestPageViewModel"
             Title="ChartTestPage">
    
    <VerticalStackLayout>
        <Label 
            Text="Chart test ^_^"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label Text="{Binding Ints.Count}"/>
        <Label Text="{Binding Ints2.Count}"/>
        <Grid WidthRequest="333" HeightRequest="333">
            <lvc:CartesianChart
            Series="{Binding Series}"
            YAxes="{Binding YAxes}"
            XAxes="{Binding XAxes}">
            </lvc:CartesianChart>
        </Grid>

        <Button Text="Add value to chart" Command="{Binding AddValueButtonCommand}" />
    </VerticalStackLayout>
</ContentPage>