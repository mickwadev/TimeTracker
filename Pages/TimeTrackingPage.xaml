<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.Pages.TimeTrackingPage"
             xmlns:pageModel="clr-namespace:TimeTracker.PageModels"
             x:DataType="pageModel:TimeTrackingPageModel"
             Title="{Binding Today}">
    <VerticalStackLayout Spacing="10" Padding="10" >
        <Label 
            Text="{Binding TicksMsg}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry Text="{Binding WorkTimeComment}" />
        <Button Text="Count working time" Command="{Binding TimeCountingButtonPressedCommand}" />
        <Button Text="Create db" Command="{Binding CreateDatabaseCommand}" />
        <Button Text="Todays working" Command="{Binding GetDatesCommand}" BackgroundColor="{StaticResource MyOrange}" />
    </VerticalStackLayout>
</ContentPage>