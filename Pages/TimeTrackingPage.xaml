<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.Pages.TimeTrackingPage"
             xmlns:pageModel="clr-namespace:TimeTracker.PageModels"
             x:DataType="pageModel:TimeTrackingPageModel"
             Title="{Binding Today}">
    <VerticalStackLayout>
        <Label 
            Text="{Binding TicksMsg}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button Text="Click..." Command="{Binding TimeCountingButtonPressedCommand}" />
    </VerticalStackLayout>
</ContentPage>