<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.Pages.WorkTimeDashboard"
             xmlns:model="clr-namespace:TimeTracker.PageModels"
             x:DataType="model:WorkTimeDashboardPageModel"
             Title="WorkTimeDashboard">
    <VerticalStackLayout>
        <Entry x:Name="DayEntry" Text="{Binding Day}"/>
        <Entry x:Name="MonthEntry" Text="{Binding Month}"/>
        <Button x:Name="SubmitButton" Text="{Binding ButtonText}"/>
    </VerticalStackLayout>
</ContentPage>