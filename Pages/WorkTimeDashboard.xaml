<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.Pages.WorkTimeDashboard"
             xmlns:model="clr-namespace:TimeTracker.PageModels"
             x:DataType="model:WorkTimeDashboardPageModel"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             Title="WorkTimeDashboard">
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Entry x:Name="DayEntry" Text="{Binding Day}"/>
            <Entry x:Name="MonthEntry" Text="{Binding Month}"/>
        </HorizontalStackLayout>
        <Button x:Name="SubmitButton" Text="{Binding ButtonText}" Command="{Binding GetDatabaseEntriesForDateCommand}"/>
        <Label x:Name="TimeLabel" Text="{Binding TimeLabel}"/>

        <Button Text="Load data to chart" Command="{Binding LoadAllWorkingHistoryCommand}" />
        <Grid WidthRequest="333" HeightRequest="333">
        <lvc:CartesianChart
             Series="{Binding Series}"
             YAxes="{Binding YAxes}"
             XAxes="{Binding XAxes}">       
        </lvc:CartesianChart>
        </Grid>
    </VerticalStackLayout>
</ContentPage>