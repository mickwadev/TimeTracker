<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeTracker.TestPages.CollectionViewFun1"
             xmlns:ms="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             Shell.BackgroundColor="White">

    <VerticalStackLayout Padding="10">
        <Image WidthRequest="33" HeightRequest="33">
            <Image.Source>
                <!-- Use FontFamily="MaterialSharpFilled" to get the filled variant of the selected glyph -->
                <FontImageSource FontFamily="MaterialSharp" Glyph="{x:Static ms:MaterialSharp.Settings_suggest}" Color="OldLace" />
            </Image.Source>
        </Image>

        <material:CheckBox></material:CheckBox>
        <material:CheckBox></material:CheckBox>
        <material:CheckBox></material:CheckBox>
        <Button StyleClass="ElevatedButton" Text="Elevated Button" />

        <material:TextField Title="Name" />
        <material:TextField Title="E-mail" Icon="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static ms:MaterialSharp.Attach_email}}"/>

        <material:RadioButtonGroupView>
            <material:RadioButton Text="Option 1" />
            <material:RadioButton Text="Option 2" />
            <material:RadioButton Text="Option 3 (Disabled)" IsDisabled="True" />
        </material:RadioButtonGroupView>

    </VerticalStackLayout>
</ContentPage>