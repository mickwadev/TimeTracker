<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TimeTracker.Controls"
             x:Class="TimeTracker.Pages.SamplePage"
             Title="SamplePage">
    <VerticalStackLayout>
        <Label Text="{AppThemeBinding Light='Light Theme', Dark='Dark Theme',Default='Default Theme'}"/>
        <controls:ControlWithAnimation/>
        <Switch Toggled="Switch_Toggled" />
        <Label x:Name="shellBkgLabel"/>
    </VerticalStackLayout>
</ContentPage>