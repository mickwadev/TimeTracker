<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TimeTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TimeTracker.Pages"
    xmlns:testPages="clr-namespace:TimeTracker.TestPages"
    xmlns:ms="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    Title="TimeTracker">

    <ShellContent Title="CollectionView test :)"
                  ContentTemplate="{DataTemplate testPages:CollectionViewFun1}"
                  Icon="{FontImageSource Glyph={x:Static ms:MaterialSharp.Dashboard}, FontFamily=MaterialSharp, Color=#460d23}"
                  />

    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate local:SettingPage}"
        Icon="{FontImageSource Glyph={x:Static ms:MaterialSharp.Assured_workload}, FontFamily=MaterialSharp, Color=#f6e2db}"
        />

    <ShellContent
            Title="My progress"
            ContentTemplate="{DataTemplate local:ProgressPage}"
            />

    <ShellContent
        Title="Time Tracking"
        ContentTemplate="{DataTemplate local:TimeTrackingPage}"
        Route="TimeTracking" />

    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate local:WorkTimeDashboard}"
        Route="Dashboard"/>

</Shell>
