<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TimeTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TimeTracker.Pages"
    Title="TimeTracker">

    <ShellContent
        Title="Chart sample"
        ContentTemplate="{DataTemplate local:ChartTestPage}"
        />

    <ShellContent
        Title="Time Tracking"
        ContentTemplate="{DataTemplate local:TimeTrackingPage}"
        Route="TimeTracking" />

    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate local:WorkTimeDashboard}"
        Route="Dashboard"/>

</Shell>
